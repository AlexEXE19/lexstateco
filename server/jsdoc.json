{
  "source": {
    "include": ["controllers", "models"],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(node_modules/|test/)"
  },
  "opts": {
    "destination": "./docs",
    "recurse": true
  },
  "plugins": ["plugins/markdown"],
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true
  }
}
